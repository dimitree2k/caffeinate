      VALUE "InternalName", "caffeinate"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "caffeinate.exe"
      VALUE "ProductName", "Caffeinate"
      VALUE "ProductVersion", "0.4.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
